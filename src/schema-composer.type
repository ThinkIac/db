fs = require 'fs'
path = require 'path'
IGNORE_DIRS = new Set ['node_modules', '.git', '.logos', '.svelte-cache', '.snapshots', '.database', 'dist', 'data', 'uploads', 'profiles', 'secrets', 'generated', 'backups', 'snapshots', 'sessions', 'shared-cache']
DECLARATION = /\b(model|enum|type|view|datasource|generator)\s+([A-Za-z_]\w*)\s*\{/g
normalize = (value) -> value.replace(/\/\/.*$/gm, '').replace(/\/\*[\s\S]*?\*\//g, '').replace(/\s+/g, ' ').trim()

declarations = (text, source, primary) ->
  result = []
  DECLARATION.lastIndex = 0
  while match = DECLARATION.exec text
    open = text.indexOf '{', match.index
    depth = 1
    cursor = open + 1
    quote = ''
    while cursor < text.length and depth > 0
      char = text[cursor]
      if quote
        if char is '\\' then cursor++ else if char is quote then quote = ''
      else if char is '"' or char is "'"
        quote = char
      else if char is '{'
        depth++
      else if char is '}'
        depth--
      cursor++
    throw new Error "DB_SCHEMA_UNCLOSED_DECLARATION:#{source}:#{match[1]}:#{match[2]}" unless depth is 0
    raw = text.slice(match.index, cursor).trim()
    result.push {kind: match[1], name: match[2], header: "#{match[1]} #{match[2]}", body: text.slice(open + 1, cursor - 1), raw, source, primary}
    DECLARATION.lastIndex = cursor
  result

modelMembers = (body) ->
  members = new Map
  for raw in body.split /\r?\n/
    line = raw.trim()
    continue if not line or line.startsWith '//'
    key = if line.startsWith('@@') then normalize(line) else line.split(/\s+/)[0]
    existing = members.get key
    if existing and normalize(existing) isnt normalize(line)
      throw new Error "DB_SCHEMA_DUPLICATE_MEMBER:#{key}"
    members.set key, line
  members

mergeModel = (base, incoming) ->
  target = modelMembers base.body
  origins = base.memberOrigins ? new Map(Array.from(target.keys()).map (name) -> [name, {source: base.source, primary: base.primary}])
  for [name, line] from modelMembers incoming.body
    current = target.get name
    if not current
      target.set name, line
      origins.set name, {source: incoming.source, primary: incoming.primary}
    else if normalize(current) isnt normalize(line) and not origins.get(name)?.primary
      throw new Error "DB_SCHEMA_FRAGMENT_CONFLICT:#{base.kind}:#{base.name}:#{name}:#{origins.get(name)?.source}:#{incoming.source}"
  body = Array.from(target.values()).map((line) -> "  #{line}").join '\n'
  {...base, body, raw: "#{base.header} {\n#{body}\n}", memberOrigins: origins}

mergeEnum = (base, incoming) ->
  values = new Map
  for body in [base.body, incoming.body]
    for raw in body.split /\r?\n/
      line = raw.trim()
      values.set normalize(line), line if line and not line.startsWith '//'
  body = Array.from(values.values()).map((line) -> "  #{line}").join '\n'
  {...base, body, raw: "#{base.header} {\n#{body}\n}"}

schemaSources = (packageDir) ->
  found = []
  visit = (dir) ->
    for entry in fs.readdirSync dir, {withFileTypes: true}
      continue if entry.isDirectory() and IGNORE_DIRS.has entry.name
      full = path.join dir, entry.name
      if entry.isDirectory() and not fs.existsSync path.join(full, 'package.json')
        visit full
      else if entry.isFile() and /\.(prisma|scriba|schema)$/i.test entry.name
        found.push full
    return
  visit packageDir
  primary = path.join packageDir, 'schema.prisma'
  found.sort (a, b) -> if a is primary then -1 else if b is primary then 1 else a.localeCompare b

effectiveSchemaPath = (packageDir) -> path.join packageDir, '.logos', 'generated', 'db', 'schema.prisma'
composePackageSchema = (packageDir) ->
  sources = schemaSources packageDir
  return null unless sources.length
  primaryPath = path.join packageDir, 'schema.prisma'
  merged = new Map
  for source in sources
    primary = source is primaryPath
    for declaration in declarations fs.readFileSync(source, 'utf8'), path.relative(packageDir, source), primary
      key = "#{declaration.kind}:#{declaration.name}"
      current = merged.get key
      if not current
        merged.set key, declaration
      else if declaration.kind in ['model', 'type', 'view']
        merged.set key, mergeModel(current, declaration)
      else if declaration.kind is 'enum'
        merged.set key, mergeEnum(current, declaration)
      else if normalize(current.raw) isnt normalize(declaration.raw) and not current.primary
        throw new Error "DB_SCHEMA_FRAGMENT_CONFLICT:#{key}:#{current.source}:#{declaration.source}"
  banner = "// Generated by Logos from: #{sources.map((source) -> path.relative(packageDir, source)).join(', ')}\n// Do not edit this file directly.\n\n"
  schema = banner + Array.from(merged.values()).map((item) -> item.raw).join('\n\n') + '\n'
  outputPath = effectiveSchemaPath packageDir
  fs.mkdirSync path.dirname(outputPath), recursive: true
  temporary = "#{outputPath}.#{process.pid}.tmp"
  fs.writeFileSync temporary, schema, 'utf8'
  fs.renameSync temporary, outputPath
  {schema, outputPath, sources}

Object.defineProperty exports, '__esModule', value: true
Object.assign exports, {effectiveSchemaPath, composePackageSchema}
